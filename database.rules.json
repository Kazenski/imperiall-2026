{
  "rules": {
    ".read": false,
    ".write": false,

    "hub_geral": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$mensagemId": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
      }
    },

    "hub_sessoes": {
      "$sessionId": {
        ".read": "auth != null",
        "whispers": {
          "$mensagemId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}